# Copy this file to backend/application.properties (gitignored).
# Replace placeholders locally, or supply these environment variables instead.
spring.datasource.url=jdbc:mysql://localhost:3306/fintrack?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=fintrack_app
spring.datasource.password=${DB_PASSWORD}
app.jwt.secret=${JWT_SECRET}
app.cors.origins=http://localhost:5500,http://127.0.0.1:5500
# Optional development-only seed: set DEMO_ENABLED=true and DEMO_PASSWORD.
app.demo.enabled=${DEMO_ENABLED:false}
app.demo.password=${DEMO_PASSWORD:}
